<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.ActividadDetalleController"
    spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label
        text="DETALLE DE LA ACTIVIDAD"
        style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <Label
        fx:id="lblEvento"
        text="Evento: "/>

    <Label
        fx:id="lblActividad"
        text="Actividad: "
        style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label
        text="Personas inscritas y asistencia"
        style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <GridPane
        hgap="10"
        vgap="10">

        <Button
            text="Participantes inscritos"
            onAction="#abrirParticipantes"
            prefWidth="190"
            prefHeight="45"
            GridPane.columnIndex="0"
            GridPane.rowIndex="0"/>

        <Button
            text="Expositores inscritos"
            onAction="#abrirExpositores"
            prefWidth="190"
            prefHeight="45"
            GridPane.columnIndex="1"
            GridPane.rowIndex="0"/>

        <Button
            text="Asistencia"
            onAction="#abrirAsistencia"
            prefWidth="190"
            prefHeight="45"
            GridPane.columnIndex="0"
            GridPane.rowIndex="1"/>

        <Button
            text="Regresar"
            onAction="#regresar"
            prefWidth="190"
            prefHeight="45"
            GridPane.columnIndex="1"
            GridPane.rowIndex="1"/>

    </GridPane>

    <Label
        fx:id="lblEstado"
        text=""/>

</VBox>
