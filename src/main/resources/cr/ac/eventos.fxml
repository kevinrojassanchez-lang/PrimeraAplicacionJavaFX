<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.EventosController"
    spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label
        text="GESTIÓN DE EVENTOS"
        style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <!-- BOTONES -->

    <GridPane
        hgap="10"
        vgap="10">

        <Button
            text="Agregar"
            onAction="#agregar"
            prefWidth="100"
            GridPane.columnIndex="0"/>

        <Button
            text="Editar"
            onAction="#editar"
            prefWidth="100"
            GridPane.columnIndex="1"/>

        <Button
            text="Abrir evento"
            onAction="#abrirEvento"
            prefWidth="120"
            GridPane.columnIndex="2"/>

        <Button
            text="Regresar"
            onAction="#regresar"
            prefWidth="100"
            GridPane.columnIndex="3"/>

    </GridPane>

    <!-- FILTRO -->

    <GridPane
        hgap="10"
        vgap="10">

        <Label
            text="Filtrar eventos:"
            GridPane.columnIndex="0"/>

        <TextField
            fx:id="txtFiltro"
            promptText="Escriba para filtrar..."
            prefWidth="300"
            GridPane.columnIndex="1"/>

    </GridPane>

    <Label
        fx:id="lblEstado"
        text=""/>

    <!-- TABLA -->

    <TableView
        fx:id="tablaEventos"
        prefHeight="350">

        <columns>

            <TableColumn
                fx:id="colCodigo"
                text="Código"
                prefWidth="100"/>

            <TableColumn
                fx:id="colNombre"
                text="Nombre"
                prefWidth="180"/>

            <TableColumn
                fx:id="colFechaInicio"
                text="Fecha inicio"
                prefWidth="110"/>

            <TableColumn
                fx:id="colFechaFinal"
                text="Fecha final"
                prefWidth="110"/>

            <TableColumn
                fx:id="colLugar"
                text="Lugar"
                prefWidth="150"/>

            <TableColumn
                fx:id="colEstado"
                text="Estado"
                prefWidth="120"/>

        </columns>

    </TableView>

</VBox>

