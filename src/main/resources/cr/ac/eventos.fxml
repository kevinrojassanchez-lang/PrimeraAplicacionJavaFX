<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.controller.EventosController"
    stylesheets="@estilos.css"
    spacing="18"
    styleClass="pantalla-neon">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label
        text="NEXUS / EVENTOS"
        styleClass="titulo-pantalla"/>

    <Label
        text="GESTIÓN Y ADMINISTRACIÓN DE EVENTOS"
        styleClass="subtitulo-pantalla"/>

    <GridPane hgap="12" vgap="12">

        <Button
            fx:id="btnAgregar"
            text="+ AGREGAR"
            onAction="#agregar"
            prefWidth="125"
            styleClass="boton-cyan"
            GridPane.columnIndex="0"/>

        <Button
            fx:id="btnEditar"
            text="EDITAR"
            onAction="#editar"
            prefWidth="115"
            styleClass="boton-magenta"
            GridPane.columnIndex="1"/>

        <Button
            text="ABRIR EVENTO"
            onAction="#abrirEvento"
            prefWidth="145"
            styleClass="boton-cyan"
            GridPane.columnIndex="2"/>

        <Button
            text="REGRESAR"
            onAction="#regresar"
            prefWidth="115"
            styleClass="boton-salir"
            GridPane.columnIndex="3"/>

    </GridPane>

    <VBox spacing="8" styleClass="panel-neon">

        <Label
            text="BUSCAR EVENTOS"
            styleClass="seccion-neon"/>

        <GridPane hgap="12">

            <Label
                text="FILTRAR:"
                styleClass="login-etiqueta"
                GridPane.columnIndex="0"/>

            <TextField
                fx:id="txtFiltro"
                promptText="Escriba para filtrar..."
                prefWidth="350"
                styleClass="login-campo"
                GridPane.columnIndex="1"/>

        </GridPane>

    </VBox>

    <Label
        fx:id="lblEstado"
        text=""
        styleClass="estado-pantalla"/>

    <TableView
        fx:id="tablaEventos"
        prefHeight="400"
        styleClass="tabla-neon">

        <columns>

            <TableColumn
                fx:id="colCodigo"
                text="Código"
                prefWidth="100"/>

            <TableColumn
                fx:id="colNombre"
                text="Nombre"
                prefWidth="180"/>

            <TableColumn
                fx:id="colFechaInicio"
                text="Fecha inicio"
                prefWidth="110"/>

            <TableColumn
                fx:id="colFechaFinal"
                text="Fecha final"
                prefWidth="110"/>

            <TableColumn
                fx:id="colLugar"
                text="Lugar"
                prefWidth="150"/>

            <TableColumn
                fx:id="colEstado"
                text="Estado"
                prefWidth="120"/>

        </columns>

    </TableView>

    <Label
        text="NEXUS 2026 | EVENT MANAGEMENT"
        styleClass="texto-inferior"/>

</VBox>
