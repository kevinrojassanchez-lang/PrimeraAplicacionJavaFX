<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.controller.LoginController"
    stylesheets="@estilos.css"
    alignment="CENTER"
    spacing="20"
    styleClass="login-principal">

    <padding>
        <Insets top="35" right="35" bottom="35" left="35"/>
    </padding>

    <VBox
        alignment="CENTER"
        spacing="18"
        maxWidth="430"
        styleClass="login-panel">

        <Label
            text="NEXUS"
            styleClass="login-titulo"/>

        <Label
            text="EVENT MANAGEMENT SYSTEM"
            styleClass="login-subtitulo"/>

        <Label
            text="INICIAR SESIÓN"
            styleClass="login-seccion"/>

        <GridPane
            hgap="12"
            vgap="18"
            alignment="CENTER">

            <Label
                text="USUARIO"
                styleClass="login-etiqueta"
                GridPane.columnIndex="0"
                GridPane.rowIndex="0"/>

            <TextField
                fx:id="txtUsuario"
                promptText="Ingrese su usuario"
                prefWidth="230"
                styleClass="login-campo"
                GridPane.columnIndex="1"
                GridPane.rowIndex="0"/>

            <Label
                text="CONTRASEÑA"
                styleClass="login-etiqueta"
                GridPane.columnIndex="0"
                GridPane.rowIndex="1"/>

            <PasswordField
                fx:id="txtContrasena"
                promptText="Ingrese su contraseña"
                prefWidth="230"
                styleClass="login-campo"
                GridPane.columnIndex="1"
                GridPane.rowIndex="1"/>

            <Button
                text="CONECTAR"
                prefWidth="230"
                prefHeight="45"
                styleClass="login-boton"
                onAction="#iniciarSesion"
                GridPane.columnIndex="1"
                GridPane.rowIndex="2"/>

            <Label
                fx:id="lblEstado"
                wrapText="true"
                styleClass="login-estado"
                GridPane.columnIndex="1"
                GridPane.rowIndex="3"/>

        </GridPane>

        <Label
            text="SYSTEM ONLINE | NEXUS 2026"
            styleClass="texto-inferior"/>

    </VBox>

</VBox>
