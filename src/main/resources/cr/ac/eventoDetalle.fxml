<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.controller.EventoDetalleController"
    stylesheets="@estilos.css"
    spacing="18"
    styleClass="pantalla-neon">

    <padding>
        <Insets top="25" right="30" bottom="25" left="30"/>
    </padding>

    <Label
        text="NEXUS / DETALLE DEL EVENTO"
        styleClass="titulo-pantalla"/>

    <Label
        text="INFORMACIÓN Y GESTIÓN DEL EVENTO SELECCIONADO"
        styleClass="subtitulo-pantalla"/>

    <VBox
        spacing="18"
        styleClass="panel-neon">

        <Label
            text="EVENTO SELECCIONADO"
            styleClass="seccion-neon"/>

        <Label
            fx:id="lblEvento"
            text="Evento seleccionado"
            wrapText="true"
            styleClass="titulo-pantalla"/>

    </VBox>

    <VBox
        spacing="15"
        styleClass="panel-neon">

        <Label
            text="GESTIÓN DEL EVENTO"
            styleClass="seccion-neon"/>

        <Label
            text="Selecciona una opción para continuar."
            styleClass="subtitulo-pantalla"/>

        <GridPane
            hgap="15"
            vgap="15">

            <Button
                text="ACTIVIDADES"
                onAction="#abrirActividades"
                prefWidth="200"
                prefHeight="50"
                styleClass="boton-cyan"
                GridPane.columnIndex="0"
                GridPane.rowIndex="0"/>

            <Button
                text="REGRESAR"
                onAction="#regresar"
                prefWidth="200"
                prefHeight="50"
                styleClass="boton-salir"
                GridPane.columnIndex="1"
                GridPane.rowIndex="0"/>

        </GridPane>

    </VBox>

    <Label
        fx:id="lblEstado"
        text=""
        wrapText="true"
        styleClass="estado-pantalla"/>

    <Label
        text="NEXUS 2026 | EVENT MANAGEMENT"
        styleClass="texto-inferior"/>

</VBox>
