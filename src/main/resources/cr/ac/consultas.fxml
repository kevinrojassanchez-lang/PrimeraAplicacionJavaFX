<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.controller.ConsultasController"
    stylesheets="@estilos.css"
    spacing="12"
    styleClass="pantalla-neon">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <Label
        text="NEXUS / CONSULTAS"
        styleClass="titulo-pantalla"/>

    <Label
        text="BÚSQUEDA Y CONSULTA DE INFORMACIÓN"
        styleClass="subtitulo-pantalla"/>

    <TabPane
        fx:id="tabConsultas"
        prefHeight="650"
        minHeight="500"
        styleClass="tab-pane"
        VBox.vgrow="ALWAYS">

        <Tab text="ACTIVIDADES" closable="false">

            <VBox
                spacing="12"
                styleClass="pantalla-neon"
                fillWidth="true">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label
                    text="CONSULTAR ACTIVIDADES"
                    styleClass="seccion-neon"/>

                <VBox spacing="10" styleClass="panel-neon">

                    <GridPane hgap="15" vgap="10">

                        <Label
                            text="ID DEL EVENTO:"
                            styleClass="login-etiqueta"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                        <TextField
                            fx:id="txtIdEventoActividad"
                            promptText="Escriba el ID del evento"
                            prefWidth="220"
                            styleClass="login-campo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>

                        <Label
                            text="FECHA:"
                            styleClass="login-etiqueta"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                        <DatePicker
                            fx:id="dpActividad"
                            prefWidth="220"
                            styleClass="login-campo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                        <Label
                            text="TIPO:"
                            styleClass="login-etiqueta"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"/>

                        <ComboBox
                            fx:id="cmbTipoActividad"
                            prefWidth="220"
                            promptText="Todos los tipos"
                            styleClass="login-campo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>

                        <Label
                            text="DISPONIBILIDAD:"
                            styleClass="login-etiqueta"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"/>

                        <ComboBox
                            fx:id="cmbDisponibilidad"
                            prefWidth="220"
                            promptText="Cualquier disponibilidad"
                            styleClass="login-campo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                    </GridPane>

                    <Button
                        text="BUSCAR ACTIVIDADES"
                        onAction="#buscarActividades"
                        prefWidth="190"
                        prefHeight="42"
                        styleClass="boton-cyan"/>

                </VBox>

                <TableView
                    fx:id="tablaActividades"
                    prefHeight="300"
                    minHeight="200"
                    VBox.vgrow="ALWAYS"
                    styleClass="tabla-neon">

                    <columns>

                        <TableColumn
                            fx:id="colActividadId"
                            text="ID"
                            prefWidth="80"/>

                        <TableColumn
                            fx:id="colActividadNombre"
                            text="Nombre"
                            prefWidth="160"/>

                        <TableColumn
                            fx:id="colActividadTipo"
                            text="Tipo"
                            prefWidth="120"/>

                        <TableColumn
                            fx:id="colActividadFecha"
                            text="Fecha"
                            prefWidth="100"/>

                        <TableColumn
                            fx:id="colActividadEvento"
                            text="Evento"
                            prefWidth="140"/>

                        <TableColumn
                            fx:id="colActividadDisponibles"
                            text="Disponibles"
                            prefWidth="100"/>

                    </columns>

                </TableView>

            </VBox>

        </Tab>

        <Tab text="INSCRIPCIONES" closable="false">

            <VBox
                spacing="12"
                styleClass="pantalla-neon"
                fillWidth="true">

                <padding>
                    <Insets top="15" right="15" bottom="15" left="15"/>
                </padding>

                <Label
                    text="CONSULTAR INSCRIPCIONES"
                    styleClass="seccion-neon"/>

                <VBox spacing="10" styleClass="panel-neon">

                    <GridPane hgap="15" vgap="10">

                        <Label
                            text="CÉDULA:"
                            styleClass="login-etiqueta"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                        <TextField
                            fx:id="txtCedulaInscripcion"
                            promptText="Escriba la cédula"
                            prefWidth="220"
                            styleClass="login-campo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>

                        <Label
                            text="TIPO:"
                            styleClass="login-etiqueta"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="1"/>

                        <ComboBox
                            fx:id="cmbTipoInscripcion"
                            prefWidth="220"
                            promptText="Todos los tipos"
                            styleClass="login-campo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="1"/>

                        <Label
                            text="ID DE ACTIVIDAD:"
                            styleClass="login-etiqueta"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="2"/>

                        <TextField
                            fx:id="txtIdActividadInscripcion"
                            promptText="Escriba el ID de actividad"
                            prefWidth="220"
                            styleClass="login-campo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="2"/>

                        <Label
                            text="ESTADO:"
                            styleClass="login-etiqueta"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="3"/>

                        <ComboBox
                            fx:id="cmbEstadoInscripcion"
                            prefWidth="220"
                            promptText="Todos los estados"
                            styleClass="login-campo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="3"/>

                    </GridPane>

                    <Button
                        text="BUSCAR INSCRIPCIONES"
                        onAction="#buscarInscripciones"
                        prefWidth="210"
                        prefHeight="42"
                        styleClass="boton-magenta"/>

                </VBox>

                <TableView
                    fx:id="tablaInscripciones"
                    prefHeight="300"
                    minHeight="200"
                    VBox.vgrow="ALWAYS"
                    styleClass="tabla-neon">

                    <columns>

                        <TableColumn
                            fx:id="colInscripcionId"
                            text="ID inscripción"
                            prefWidth="110"/>

                        <TableColumn
                            fx:id="colInscripcionPersona"
                            text="Persona"
                            prefWidth="160"/>

                        <TableColumn
                            fx:id="colInscripcionTipo"
                            text="Tipo"
                            prefWidth="110"/>

                        <TableColumn
                            fx:id="colInscripcionActividad"
                            text="Actividad"
                            prefWidth="160"/>

                        <TableColumn
                            fx:id="colInscripcionFecha"
                            text="Fecha"
                            prefWidth="100"/>

                        <TableColumn
                            fx:id="colInscripcionEstado"
                            text="Estado"
                            prefWidth="110"/>

                    </columns>

                </TableView>

            </VBox>

        </Tab>

    </TabPane>

    <Label
        fx:id="lblEstado"
        text=""
        styleClass="estado-pantalla"
        wrapText="true"/>

    <Button
        text="REGRESAR"
        onAction="#regresar"
        prefWidth="120"
        prefHeight="42"
        styleClass="boton-salir"/>

    <Label
        text="NEXUS 2026 | DATA CONSULTATION"
        styleClass="texto-inferior"/>

</VBox>
