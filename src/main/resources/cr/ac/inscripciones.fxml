<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.controller.InscripcionesController"
    stylesheets="@estilos.css"
    spacing="18"
    styleClass="pantalla-neon">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label
        text="NEXUS / INSCRIPCIONES"
        styleClass="titulo-pantalla"/>

    <Label
        text="GESTIÓN DE PARTICIPANTES Y EXPOSITORES"
        styleClass="subtitulo-pantalla"/>

    <VBox
        spacing="12"
        styleClass="panel-neon">

        <Label
            text="ACCIONES DE INSCRIPCIÓN"
            styleClass="seccion-neon"/>

        <GridPane
            hgap="12"
            vgap="12">

            <Button
                text="INSCRIBIR PARTICIPANTE"
                onAction="#inscribirParticipante"
                prefWidth="200"
                prefHeight="50"
                styleClass="boton-cyan"
                GridPane.columnIndex="0"
                GridPane.rowIndex="0"/>

            <Button
                text="INSCRIBIR EXPOSITOR"
                onAction="#inscribirExpositor"
                prefWidth="190"
                prefHeight="50"
                styleClass="boton-magenta"
                GridPane.columnIndex="1"
                GridPane.rowIndex="0"/>

            <Button
                fx:id="btnEditar"
                text="EDITAR DATOS"
                onAction="#editar"
                prefWidth="170"
                prefHeight="50"
                styleClass="boton-cyan"
                GridPane.columnIndex="2"
                GridPane.rowIndex="0"/>

            <Button
                fx:id="btnCancelar"
                text="CANCELAR INSCRIPCIÓN"
                onAction="#cambiarEstadoInscripcion"
                prefWidth="210"
                prefHeight="50"
                styleClass="boton-salir"
                GridPane.columnIndex="3"
                GridPane.rowIndex="0"/>

            <Button
                text="REGRESAR"
                onAction="#regresar"
                prefWidth="120"
                prefHeight="45"
                styleClass="boton-salir"
                GridPane.columnIndex="4"
                GridPane.rowIndex="0"/>

        </GridPane>

    </VBox>

    <VBox
        spacing="10"
        styleClass="panel-neon">

        <Label
            text="BUSCAR INSCRIPCIONES"
            styleClass="seccion-neon"/>

        <GridPane hgap="12">

            <Label
                text="FILTRAR:"
                styleClass="login-etiqueta"
                GridPane.columnIndex="0"/>

            <TextField
                fx:id="txtFiltro"
                promptText="Escriba para filtrar..."
                prefWidth="350"
                styleClass="login-campo"
                GridPane.columnIndex="1"/>

        </GridPane>

    </VBox>

    <Label
        fx:id="lblEstado"
        text=""
        styleClass="estado-pantalla"
        wrapText="true"/>

    <TableView
        fx:id="tablaInscripciones"
        prefHeight="400"
        styleClass="tabla-neon">

        <columns>

            <TableColumn
                fx:id="colId"
                text="ID inscripción"
                prefWidth="110"/>

            <TableColumn
                fx:id="colPersona"
                text="Persona"
                prefWidth="180"/>

            <TableColumn
                fx:id="colTipo"
                text="Tipo"
                prefWidth="120"/>

            <TableColumn
                fx:id="colActividad"
                text="Actividad"
                prefWidth="180"/>

            <TableColumn
                fx:id="colFecha"
                text="Fecha"
                prefWidth="110"/>

            <TableColumn
                fx:id="colHora"
                text="Hora"
                prefWidth="90"/>

            <TableColumn
                fx:id="colEstado"
                text="Estado"
                prefWidth="120"/>

        </columns>

    </TableView>

    <Label
        text="NEXUS 2026 | REGISTRATION MANAGEMENT"
        styleClass="texto-inferior"/>

</VBox>
