<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.ExpositoresController"
    spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label
        text="EXPOSITORES INSCRITOS"
        style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane
        hgap="10"
        vgap="10">

        <Button
            text="Editar"
            onAction="#editar"
            prefWidth="100"
            GridPane.columnIndex="0"/>

        <Button
            text="Regresar"
            onAction="#regresar"
            prefWidth="100"
            GridPane.columnIndex="1"/>

    </GridPane>

    <GridPane
        hgap="10"
        vgap="10">

        <Label
            text="Filtrar expositores:"
            GridPane.columnIndex="0"/>

        <TextField
            fx:id="txtFiltro"
            promptText="Escriba para filtrar..."
            prefWidth="300"
            GridPane.columnIndex="1"/>

    </GridPane>

    <Label
        fx:id="lblEstado"
        text=""/>

    <TableView
        fx:id="tablaExpositores"
        prefHeight="350">

        <columns>

            <TableColumn
                fx:id="colIdentificacion"
                text="Identificación"
                prefWidth="120"/>

            <TableColumn
                fx:id="colNombre"
                text="Nombre"
                prefWidth="120"/>

            <TableColumn
                fx:id="colApellidos"
                text="Apellidos"
                prefWidth="160"/>

            <TableColumn
                fx:id="colCorreo"
                text="Correo"
                prefWidth="180"/>

            <TableColumn
                fx:id="colTelefono"
                text="Teléfono"
                prefWidth="120"/>

            <TableColumn
                fx:id="colEspecialidad"
                text="Especialidad"
                prefWidth="160"/>

            <TableColumn
                fx:id="colEstado"
                text="Estado"
                prefWidth="100"/>

        </columns>

    </TableView>

</VBox>
