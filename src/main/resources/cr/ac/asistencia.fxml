<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.controller.AsistenciaController"
    stylesheets="@estilos.css"
    spacing="18"
    styleClass="pantalla-neon">

    <padding>
        <Insets top="25" right="25" bottom="25" left="25"/>
    </padding>

    <Label
        text="NEXUS / ASISTENCIA"
        styleClass="titulo-pantalla"/>

    <Label
        text="REGISTRO Y CONTROL DE ASISTENCIA"
        styleClass="subtitulo-pantalla"/>

    <VBox
        spacing="10"
        styleClass="panel-neon">

        <Label
            text="ACTIVIDAD SELECCIONADA"
            styleClass="seccion-neon"/>

        <Label
            fx:id="lblActividad"
            text="Actividad seleccionada"
            styleClass="titulo-pantalla"
            wrapText="true"/>

    </VBox>

    <TableView
        fx:id="tablaAsistencia"
        prefHeight="300"
        styleClass="tabla-neon">

        <columns>

            <TableColumn
                fx:id="colIdentificacion"
                text="Identificación"
                prefWidth="140"/>

            <TableColumn
                fx:id="colPersona"
                text="Persona"
                prefWidth="220"/>

            <TableColumn
                fx:id="colTipo"
                text="Tipo"
                prefWidth="120"/>

            <TableColumn
                fx:id="colAsistencia"
                text="Asistencia"
                prefWidth="160"/>

        </columns>

    </TableView>

    <VBox
        spacing="15"
        styleClass="panel-neon">

        <Label
            text="ESTADÍSTICAS DE ASISTENCIA"
            styleClass="seccion-neon"/>

        <GridPane
            hgap="25"
            vgap="18">

            <Label
                text="TOTAL INSCRITOS"
                styleClass="login-etiqueta"
                GridPane.columnIndex="0"
                GridPane.rowIndex="0"/>

            <Label
                fx:id="lblTotal"
                text="0"
                styleClass="titulo-pantalla"
                GridPane.columnIndex="1"
                GridPane.rowIndex="0"/>

            <Label
                text="ASISTIERON"
                styleClass="login-etiqueta"
                GridPane.columnIndex="2"
                GridPane.rowIndex="0"/>

            <Label
                fx:id="lblAsistieron"
                text="0"
                styleClass="titulo-pantalla"
                GridPane.columnIndex="3"
                GridPane.rowIndex="0"/>

            <Label
                text="NO ASISTIERON"
                styleClass="login-etiqueta"
                GridPane.columnIndex="0"
                GridPane.rowIndex="1"/>

            <Label
                fx:id="lblNoAsistieron"
                text="0"
                styleClass="titulo-pantalla"
                GridPane.columnIndex="1"
                GridPane.rowIndex="1"/>

            <Label
                text="PORCENTAJE"
                styleClass="login-etiqueta"
                GridPane.columnIndex="2"
                GridPane.rowIndex="1"/>

            <Label
                fx:id="lblPorcentaje"
                text="0%"
                styleClass="titulo-pantalla"
                GridPane.columnIndex="3"
                GridPane.rowIndex="1"/>

        </GridPane>

    </VBox>

    <GridPane hgap="12" vgap="12">

        <Button
            text="CONSULTAR ASISTENCIA"
            onAction="#consultar"
            prefWidth="200"
            prefHeight="45"
            styleClass="boton-cyan"
            GridPane.columnIndex="0"/>

        <Button
            text="REGRESAR"
            onAction="#regresar"
            prefWidth="120"
            prefHeight="45"
            styleClass="boton-salir"
            GridPane.columnIndex="1"/>

    </GridPane>

    <Label
        fx:id="lblEstado"
        text=""
        styleClass="estado-pantalla"
        wrapText="true"/>

    <Label
        text="NEXUS 2026 | ATTENDANCE CONTROL"
        styleClass="texto-inferior"/>

</VBox>
