<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.ExpositorFormularioController"
    spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label
        fx:id="lblTitulo"
        text="INSCRIBIR EXPOSITOR"
        style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane hgap="10" vgap="10">

        <Label
            text="ID inscripción:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="0"/>

        <TextField
            fx:id="txtIdInscripcion"
            GridPane.columnIndex="1"
            GridPane.rowIndex="0"/>

        <Label
            text="Identificación:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="1"/>

        <TextField
            fx:id="txtIdentificacion"
            GridPane.columnIndex="1"
            GridPane.rowIndex="1"/>

        <Label
            text="Nombre:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="2"/>

        <TextField
            fx:id="txtNombre"
            GridPane.columnIndex="1"
            GridPane.rowIndex="2"/>

        <Label
            text="Apellidos:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="3"/>

        <TextField
            fx:id="txtApellidos"
            GridPane.columnIndex="1"
            GridPane.rowIndex="3"/>

        <Label
            text="Correo:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="4"/>

        <TextField
            fx:id="txtCorreo"
            GridPane.columnIndex="1"
            GridPane.rowIndex="4"/>

        <Label
            text="Teléfono:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="5"/>

        <TextField
            fx:id="txtTelefono"
            GridPane.columnIndex="1"
            GridPane.rowIndex="5"/>

        <Label
            text="Profesión / Especialidad:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="6"/>

        <TextField
            fx:id="txtEspecialidad"
            GridPane.columnIndex="1"
            GridPane.rowIndex="6"/>

        <Label
            text="Descripción profesional:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="7"/>

        <TextArea
            fx:id="txtDescripcion"
            prefRowCount="4"
            prefWidth="250"
            GridPane.columnIndex="1"
            GridPane.rowIndex="7"/>

        <Label
            text="Actividad:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="8"/>

        <ComboBox
            fx:id="cmbActividad"
            prefWidth="220"
            GridPane.columnIndex="1"
            GridPane.rowIndex="8"/>

        <Label
            text="Fecha:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="9"/>

        <DatePicker
            fx:id="dpFecha"
            GridPane.columnIndex="1"
            GridPane.rowIndex="9"/>

        <Label
            text="Hora:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="10"/>

        <TextField
            fx:id="txtHora"
            promptText="HH:mm"
            GridPane.columnIndex="1"
            GridPane.rowIndex="10"/>

        <Label
            text="Estado:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="11"/>

        <ComboBox
            fx:id="cmbEstado"
            prefWidth="220"
            GridPane.columnIndex="1"
            GridPane.rowIndex="11"/>

    </GridPane>

    <GridPane hgap="10" vgap="10">

        <Button
            text="Guardar"
            onAction="#guardar"
            prefWidth="100"
            GridPane.columnIndex="0"/>

        <Button
            text="Cancelar"
            onAction="#cancelar"
            prefWidth="100"
            GridPane.columnIndex="1"/>

    </GridPane>

    <Label
        fx:id="lblEstado"
        text=""/>

</VBox>

