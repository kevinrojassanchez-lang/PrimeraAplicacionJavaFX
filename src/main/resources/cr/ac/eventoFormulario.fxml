<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.EventoFormularioController"
    spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label
        fx:id="lblTitulo"
        text="NUEVO EVENTO"
        style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

    <GridPane
        hgap="10"
        vgap="10">

        <Label
            text="Código:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="0"/>

        <TextField
            fx:id="txtCodigo"
            GridPane.columnIndex="1"
            GridPane.rowIndex="0"/>

        <Label
            text="Nombre:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="1"/>

        <TextField
            fx:id="txtNombre"
            GridPane.columnIndex="1"
            GridPane.rowIndex="1"/>

        <Label
            text="Descripción:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="2"/>

        <TextArea
            fx:id="txtDescripcion"
            prefRowCount="3"
            GridPane.columnIndex="1"
            GridPane.rowIndex="2"/>

        <Label
            text="Fecha inicio:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="3"/>

        <DatePicker
            fx:id="dpFechaInicio"
            GridPane.columnIndex="1"
            GridPane.rowIndex="3"/>

        <Label
            text="Fecha final:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="4"/>

        <DatePicker
            fx:id="dpFechaFinal"
            GridPane.columnIndex="1"
            GridPane.rowIndex="4"/>

        <Label
            text="Lugar:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="5"/>

        <TextField
            fx:id="txtLugar"
            GridPane.columnIndex="1"
            GridPane.rowIndex="5"/>

        <Label
            text="Estado:"
            GridPane.columnIndex="0"
            GridPane.rowIndex="6"/>

        <ComboBox
            fx:id="cmbEstado"
            prefWidth="200"
            GridPane.columnIndex="1"
            GridPane.rowIndex="6"/>

    </GridPane>

    <GridPane
        hgap="10"
        vgap="10">

        <Button
            text="Guardar"
            onAction="#guardar"
            prefWidth="100"
            GridPane.columnIndex="0"/>

        <Button
            text="Cancelar"
            onAction="#cancelar"
            prefWidth="100"
            GridPane.columnIndex="1"/>

    </GridPane>

    <Label
        fx:id="lblEstado"
        text=""/>

</VBox>

