<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.MenuController"
    alignment="CENTER"
    spacing="15">

    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label
        text="SISTEMA DE GESTIÓN DE EVENTOS Y PARTICIPANTES"
        style="-fx-font-size: 20px; -fx-font-weight: bold;"/>

    <Label
        text="Menú principal"
        style="-fx-font-size: 16px;"/>

    <GridPane
        hgap="10"
        vgap="10"
        alignment="CENTER">

        <Button
            text="Eventos"
            prefWidth="150"
            prefHeight="40"
            onAction="#abrirEventos"
            GridPane.columnIndex="0"
            GridPane.rowIndex="0"/>

        <Button
            text="Inscripciones"
            prefWidth="150"
            prefHeight="40"
            onAction="#abrirInscripciones"
            GridPane.columnIndex="1"
            GridPane.rowIndex="0"/>

        <Button
            text="Consultas"
            prefWidth="150"
            prefHeight="40"
            onAction="#abrirConsultas"
            GridPane.columnIndex="0"
            GridPane.rowIndex="1"/>

        <Button
            text="Reportes"
            prefWidth="150"
            prefHeight="40"
            onAction="#abrirReportes"
            GridPane.columnIndex="1"
            GridPane.rowIndex="1"/>

    </GridPane>

    <Button
        text="Cerrar sesión"
        prefWidth="150"
        onAction="#cerrarSesion"/>

</VBox>

