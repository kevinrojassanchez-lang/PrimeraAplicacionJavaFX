<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.controller.MenuController"
    stylesheets="@estilos.css"
    alignment="CENTER"
    spacing="25"
    styleClass="menu-principal">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label
        text="NEXUS"
        styleClass="titulo-neon"/>

    <Label
        text="SISTEMA DE GESTIÓN DE EVENTOS Y PARTICIPANTES"
        styleClass="subtitulo-neon"/>

    <Label
        text="MENÚ PRINCIPAL"
        styleClass="seccion-neon"/>

    <GridPane
        hgap="20"
        vgap="20"
        alignment="CENTER">

        <Button
            fx:id="btnEventos"
            text="EVENTOS"
            prefWidth="190"
            prefHeight="65"
            styleClass="boton-cyan"
            onAction="#abrirEventos"
            GridPane.columnIndex="0"
            GridPane.rowIndex="0"/>

        <Button
            fx:id="btnInscripciones"
            text="INSCRIPCIONES"
            prefWidth="190"
            prefHeight="65"
            styleClass="boton-magenta"
            onAction="#abrirInscripciones"
            GridPane.columnIndex="1"
            GridPane.rowIndex="0"/>

        <Button
            fx:id="btnConsultas"
            text="CONSULTAS"
            prefWidth="190"
            prefHeight="65"
            styleClass="boton-magenta"
            onAction="#abrirConsultas"
            GridPane.columnIndex="0"
            GridPane.rowIndex="1"/>

        <Button
            fx:id="btnReportes"
            text="REPORTES"
            prefWidth="190"
            prefHeight="65"
            styleClass="boton-cyan"
            onAction="#abrirReportes"
            GridPane.columnIndex="1"
            GridPane.rowIndex="1"/>

    </GridPane>

    <Button
        text="CERRAR SESIÓN"
        prefWidth="190"
        prefHeight="45"
        styleClass="boton-salir"
        onAction="#cerrarSesion"/>

    <Label
        text="SYSTEM ONLINE  |  NEXUS 2026"
        styleClass="texto-inferior"/>

</VBox>
