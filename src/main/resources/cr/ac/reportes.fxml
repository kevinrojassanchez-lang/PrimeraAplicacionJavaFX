<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.controller.ReportesController"
    stylesheets="@estilos.css"
    spacing="12"
    styleClass="pantalla-neon">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <Label
        text="NEXUS / REPORTES"
        styleClass="titulo-pantalla"/>

    <Label
        text="GENERACIÓN Y ANÁLISIS DE INFORMACIÓN"
        styleClass="subtitulo-pantalla"/>

    <TabPane
        fx:id="tabReportes"
        prefHeight="550"
        minHeight="450"
        styleClass="tab-pane"
        VBox.vgrow="ALWAYS">

        <Tab text="Mayor participación" closable="false">

            <VBox
                spacing="15"
                styleClass="pantalla-neon">

                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <Label
                    text="ACTIVIDADES CON MAYOR PARTICIPACIÓN"
                    styleClass="seccion-neon"/>

                <Label
                    text="Consulta las actividades con mayor cantidad de inscritos."
                    styleClass="subtitulo-pantalla"/>

                <Button
                    text="GENERAR REPORTE"
                    onAction="#reporteMayorParticipacion"
                    prefWidth="190"
                    prefHeight="42"
                    styleClass="boton-cyan"/>

                <TableView
                    fx:id="tablaMayorParticipacion"
                    prefHeight="350"
                    minHeight="200"
                    VBox.vgrow="ALWAYS"
                    styleClass="tabla-neon">

                    <columns>

                        <TableColumn
                            fx:id="colMayorActividad"
                            text="Actividad"
                            prefWidth="250"/>

                        <TableColumn
                            fx:id="colMayorEvento"
                            text="Evento"
                            prefWidth="220"/>

                        <TableColumn
                            fx:id="colMayorInscritos"
                            text="Cantidad de inscritos"
                            prefWidth="180"/>

                    </columns>

                </TableView>

            </VBox>

        </Tab>

        <Tab text="Resumen de asistencia" closable="false">

            <VBox
                spacing="15"
                styleClass="pantalla-neon">

                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <Label
                    text="RESUMEN DE ASISTENCIA POR ACTIVIDAD"
                    styleClass="seccion-neon"/>

                <VBox
                    spacing="12"
                    styleClass="panel-neon">

                    <Label
                        text="BUSCAR ACTIVIDAD"
                        styleClass="login-etiqueta"/>

                    <GridPane hgap="15" vgap="10">

                        <Label
                            text="ID de actividad:"
                            styleClass="login-etiqueta"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                        <TextField
                            fx:id="txtIdActividadAsistencia"
                            promptText="Ingrese el ID de actividad"
                            prefWidth="280"
                            styleClass="login-campo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>

                    </GridPane>

                    <Button
                        text="GENERAR REPORTE"
                        onAction="#reporteAsistencia"
                        prefWidth="190"
                        prefHeight="42"
                        styleClass="boton-magenta"/>

                </VBox>

                <TableView
                    fx:id="tablaAsistenciaReporte"
                    prefHeight="300"
                    minHeight="200"
                    VBox.vgrow="ALWAYS"
                    styleClass="tabla-neon">

                    <columns>

                        <TableColumn
                            fx:id="colAsistenciaActividad"
                            text="Actividad"
                            prefWidth="180"/>

                        <TableColumn
                            fx:id="colTotalInscritos"
                            text="Total inscritos"
                            prefWidth="130"/>

                        <TableColumn
                            fx:id="colAsistieron"
                            text="Asistieron"
                            prefWidth="120"/>

                        <TableColumn
                            fx:id="colNoAsistieron"
                            text="No asistieron"
                            prefWidth="140"/>

                        <TableColumn
                            fx:id="colPorcentaje"
                            text="Porcentaje"
                            prefWidth="120"/>

                    </columns>

                </TableView>

            </VBox>

        </Tab>

        <Tab text="Historial participante" closable="false">

            <VBox
                spacing="15"
                styleClass="pantalla-neon">

                <padding>
                    <Insets top="18" right="18" bottom="18" left="18"/>
                </padding>

                <Label
                    text="HISTORIAL DE PARTICIPACIÓN"
                    styleClass="seccion-neon"/>

                <Label
                    text="Consulta el historial de actividades de un participante."
                    styleClass="subtitulo-pantalla"/>

                <VBox
                    spacing="12"
                    styleClass="panel-neon">

                    <Label
                        text="BUSCAR PARTICIPANTE"
                        styleClass="login-etiqueta"/>

                    <GridPane hgap="15" vgap="10">

                        <Label
                            text="Cédula del participante:"
                            styleClass="login-etiqueta"
                            GridPane.columnIndex="0"
                            GridPane.rowIndex="0"/>

                        <TextField
                            fx:id="txtCedulaHistorial"
                            promptText="Ingrese la cédula"
                            prefWidth="280"
                            styleClass="login-campo"
                            GridPane.columnIndex="1"
                            GridPane.rowIndex="0"/>

                    </GridPane>

                    <Button
                        text="GENERAR REPORTE"
                        onAction="#reporteHistorial"
                        prefWidth="190"
                        prefHeight="42"
                        styleClass="boton-cyan"/>

                </VBox>

                <TableView
                    fx:id="tablaHistorial"
                    prefHeight="300"
                    minHeight="200"
                    VBox.vgrow="ALWAYS"
                    styleClass="tabla-neon">

                    <columns>

                        <TableColumn
                            fx:id="colHistorialEvento"
                            text="Evento"
                            prefWidth="180"/>

                        <TableColumn
                            fx:id="colHistorialActividad"
                            text="Actividad"
                            prefWidth="190"/>

                        <TableColumn
                            fx:id="colHistorialFecha"
                            text="Fecha"
                            prefWidth="120"/>

                        <TableColumn
                            fx:id="colHistorialEstado"
                            text="Estado inscripción"
                            prefWidth="160"/>

                        <TableColumn
                            fx:id="colHistorialAsistencia"
                            text="Asistencia"
                            prefWidth="130"/>

                    </columns>

                </TableView>

            </VBox>

        </Tab>

    </TabPane>

    <Label
        fx:id="lblEstado"
        text=""
        styleClass="estado-pantalla"
        wrapText="true"/>

    <Button
        text="REGRESAR"
        onAction="#regresar"
        prefWidth="130"
        prefHeight="42"
        styleClass="boton-salir"/>

    <Label
        text="NEXUS 2026 | REPORTING SYSTEM"
        styleClass="texto-inferior"/>

</VBox>
