<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<VBox
    xmlns:fx="http://javafx.com/fxml"
    fx:controller="cr.ac.ejemplo.controller.ParticipantesController"
    stylesheets="@estilos.css"
    spacing="15"
    styleClass="pantalla-neon">

    <padding>
        <Insets top="20" right="25" bottom="20" left="25"/>
    </padding>

    <Label
        text="NEXUS / PARTICIPANTES"
        styleClass="titulo-pantalla"/>

    <Label
        text="GESTIÓN Y CONSULTA DE PARTICIPANTES INSCRITOS"
        styleClass="subtitulo-pantalla"/>

    <VBox
        spacing="12"
        styleClass="panel-neon">

        <Label
            text="BÚSQUEDA DE PARTICIPANTES"
            styleClass="seccion-neon"/>

        <GridPane
            hgap="15"
            vgap="10">

            <Label
                text="Filtrar participantes:"
                styleClass="login-etiqueta"
                GridPane.columnIndex="0"
                GridPane.rowIndex="0"/>

            <TextField
                fx:id="txtFiltro"
                promptText="Escriba para filtrar..."
                prefWidth="350"
                styleClass="login-campo"
                GridPane.columnIndex="1"
                GridPane.rowIndex="0"/>

        </GridPane>

    </VBox>

    <Label
        fx:id="lblEstado"
        text=""
        wrapText="true"
        styleClass="estado-pantalla"/>

    <TableView
        fx:id="tablaParticipantes"
        prefHeight="420"
        minHeight="250"
        VBox.vgrow="ALWAYS"
        styleClass="tabla-neon">

        <columns>

            <TableColumn
                fx:id="colIdentificacion"
                text="Identificación"
                prefWidth="130"/>

            <TableColumn
                fx:id="colNombre"
                text="Nombre"
                prefWidth="140"/>

            <TableColumn
                fx:id="colApellidos"
                text="Apellidos"
                prefWidth="170"/>

            <TableColumn
                fx:id="colCorreo"
                text="Correo"
                prefWidth="210"/>

            <TableColumn
                fx:id="colTelefono"
                text="Teléfono"
                prefWidth="120"/>

            <TableColumn
                fx:id="colFecha"
                text="Fecha inscripción"
                prefWidth="150"/>

            <TableColumn
                fx:id="colEstado"
                text="Estado"
                prefWidth="110"/>

        </columns>

    </TableView>

    <Button
        text="REGRESAR"
        onAction="#regresar"
        prefWidth="130"
        prefHeight="42"
        styleClass="boton-salir"/>

    <Label
        text="NEXUS 2026 | PARTICIPANT MANAGEMENT"
        styleClass="texto-inferior"/>

</VBox>
